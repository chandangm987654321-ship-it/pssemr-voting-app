# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Neon PostgreSQL connection string (e.g. postgresql://user:pass@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require)
NEON_DATABASE_URL=""

# Server-side Admin Password & Session Signing Secret
PSSEMR_ADMIN_PASSWORD="pssemr_admin"
PSSEMR_SESSION_SECRET="change-this-to-a-long-random-secret"
